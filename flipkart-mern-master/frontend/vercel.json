{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://flipkart-backend-kf09.onrender.com/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://flipkart-backend-kf09.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
